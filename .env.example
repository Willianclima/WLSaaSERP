# ==============================================================================
# AURA ERP & SAAS MULTI-TENANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before deploying to production.
# NEVER commit real credentials or .env files to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Cloud SQL / Neon / Supabase / RDS)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Recommended for production)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/aura_production_db

# Option B: Individual Connection Parameters (Alternative)
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_secure_database_password_here
SQL_DB_NAME=aura_db

# Enable SSL for remote databases (e.g. AWS RDS, Neon, Supabase)
DATABASE_SSL=false
# Maximum connections in pool
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# In Google Cloud Run / AI Studio containers, internal nginx proxies externally to 3000.
# For standalone Docker / VPS / Railway / Render, specify APP_PORT or PORT.
APP_PORT=3000

# MANDATORY FOR PRODUCTION DEPLOYMENTS:
# Set NODE_ENV=production to enforce strict multi-tenant isolation, disable dev tooling,
# and enforce cryptographic token validation without exception.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS (MANDATORY & ZERO-FALLBACK)
# ------------------------------------------------------------------------------
# CRITICAL / MANDATORY: Strong secret used to cryptographically sign HMAC-SHA256 session tokens and JWTs.
# The server will fail fast or reject requests if this key is absent or insecure.
# Generate a secure 256-bit key via terminal: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_string_in_production

# [SECURITY AUDIT & ZERO-FALLBACK POLICY]:
# Permanent deactivation of demo/fallback authentication:
# - All debug, demo, and automatic user fallback mechanisms (e.g. ENABLE_DEV_AUTH_DEMO_FALLBACK)
#   have been PERMANENTLY REMOVED from the codebase.
# - ALL endpoints behind authMiddleware require a valid 'Authorization: Bearer <token>' header.
# - Any request lacking a valid cryptographic token is immediately rejected with HTTP 401 Unauthorized,
#   regardless of the environment (development, staging, or production).
# - Do NOT attempt to re-enable bypasses or mock users in production.

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini API)
# ------------------------------------------------------------------------------
# Required for AI descriptions, visual matching, and assistant features.
# In AI Studio, this is managed via the Secrets panel.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE CONFIGURATION (Media / Product Images / Logo Uploads)
# ------------------------------------------------------------------------------
# Provider options: LOCAL_STORAGE | AWS_S3 | CLOUDFLARE_R2 | GOOGLE_CLOUD_STORAGE
STORAGE_PROVIDER=LOCAL_STORAGE

# AWS S3 Configuration (if using AWS_S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=aura-semijoias-media

# Cloudflare R2 Configuration (if using CLOUDFLARE_R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-media-r2

# Optional CDN URL (CloudFront, Cloudflare, etc.)
CDN_BASE_URL=

# ------------------------------------------------------------------------------
# 6. INVENTORY CONCURRENCY & RESERVATION WORKER
# ------------------------------------------------------------------------------
ENABLE_RESERVATION_EXPIRY_WORKER=true
DEFAULT_RESERVATION_TTL_MINUTES=15
RESERVATION_SWEEP_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 7. APPLICATION URL
# ------------------------------------------------------------------------------
# Base URL where the app is hosted (e.g. https://app.auraerp.com.br)
APP_URL=http://localhost:3000

